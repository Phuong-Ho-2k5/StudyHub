# Dùng cho chạy local và Docker Compose. Không commit file .env.
POSTGRES_DB=studyhub
POSTGRES_USER=studyhub
POSTGRES_PASSWORD=
DATABASE_URL=
# Docker Compose tự đặt DATABASE_URL với hostname db; local dùng localhost.
BACKEND_PORT=8080
JWT_SECRET=
JWT_EXPIRATION=900000
AI_SERVICE_URL=http://localhost:8000
# Shared internal token for backend and AI Service; use a random value.
AI_SERVICE_TOKEN=
AI_SERVICE_TIMEOUT_SECONDS=240
AI_MAX_FILE_BYTES=20971520
AI_MAX_PAGES=200
AI_EXTRACTION_TIMEOUT_SECONDS=180
AI_PICTURE_DESCRIPTIONS=false
AI_PICTURE_MODEL=HuggingFaceTB/SmolVLM-256M-Instruct
# Keep chunk tokenizer and embedding model aligned.
AI_CHUNK_TOKENIZER_MODEL=intfloat/multilingual-e5-small
AI_CHUNK_MAX_TOKENS=384
AI_CHUNK_OVERLAP_TOKENS=48
AI_EMBEDDING_MODEL=intfloat/multilingual-e5-small
AI_EMBEDDING_REVISION=614241f622f53c4eeff9890bdc4f31cfecc418b3
AI_EMBEDDING_DIMENSIONS=384
AI_EMBEDDING_TIMEOUT_SECONDS=120
LLM_API_KEY=
DOCUMENT_STORAGE_ROOT=uploads/documents
DOCUMENT_MAX_FILE_SIZE=20MB
DOCUMENT_MAX_REQUEST_SIZE=21MB
DOCUMENT_INGESTION_WORKER_ENABLED=true
DOCUMENT_INGESTION_POLL_DELAY_MS=1000
# Must exceed AI_SERVICE_TIMEOUT_SECONDS by at least 30 seconds.
DOCUMENT_INGESTION_LEASE_SECONDS=600
DOCUMENT_INGESTION_MAX_ATTEMPTS=3
LLM_MODEL=
