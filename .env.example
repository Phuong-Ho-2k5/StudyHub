# Dùng cho chạy local và Docker Compose. Không commit file .env.
POSTGRES_DB=studyhub
POSTGRES_USER=studyhub
POSTGRES_PASSWORD=
DATABASE_URL=
# Docker Compose tự đặt DATABASE_URL với hostname db; local dùng localhost.
BACKEND_PORT=8080
JWT_SECRET=
JWT_EXPIRATION=900000
AI_SERVICE_URL=http://localhost:8000
# Shared internal token for backend and AI Service; use a random value.
AI_SERVICE_TOKEN=
AI_SERVICE_TIMEOUT_SECONDS=240
AI_MAX_FILE_BYTES=20971520
AI_MAX_PAGES=200
AI_EXTRACTION_TIMEOUT_SECONDS=180
AI_PICTURE_DESCRIPTIONS=false
AI_PICTURE_MODEL=HuggingFaceTB/SmolVLM-256M-Instruct
LLM_API_KEY=
EMBEDDING_MODEL=
DOCUMENT_STORAGE_ROOT=uploads/documents
DOCUMENT_MAX_FILE_SIZE=20MB
DOCUMENT_MAX_REQUEST_SIZE=21MB
LLM_MODEL=
