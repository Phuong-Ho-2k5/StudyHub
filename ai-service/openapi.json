{
  "openapi": "3.1.0",
  "info": {
    "title": "StudyHub AI Service",
    "version": "0.1.0"
  },
  "paths": {
    "/internal/documents/extract": {
      "post": {
        "tags": [
          "Internal extraction"
        ],
        "summary": "Extract Document",
        "operationId": "extract_document_internal_documents_extract_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_extract_document_internal_documents_extract_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExtractionResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid internal service token"
          },
          "413": {
            "description": "File or page limit exceeded"
          },
          "415": {
            "description": "Invalid or protected PDF"
          },
          "422": {
            "description": "Invalid fields or incomplete conversion"
          },
          "503": {
            "description": "Model, OCR or extraction worker unavailable"
          },
          "504": {
            "description": "Conversion timed out"
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    },
    "/internal/embeddings": {
      "post": {
        "tags": [
          "Internal embeddings"
        ],
        "summary": "Embed Documents",
        "description": "Embed 1–32 texts in order. Adds the E5 passage or query prefix internally; defaults to passage.",
        "operationId": "embed_documents_internal_embeddings_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmbeddingRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmbeddingResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid internal service token"
          },
          "413": {
            "description": "Request size limit exceeded"
          },
          "422": {
            "description": "Invalid batch or input exceeds the token budget"
          },
          "503": {
            "description": "Missing configuration, busy or unavailable model"
          },
          "504": {
            "description": "Embedding deadline exceeded"
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    },
    "/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Body_extract_document_internal_documents_extract_post": {
        "properties": {
          "documentId": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Documentid"
          },
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          },
          "includeChunks": {
            "type": "boolean",
            "title": "Includechunks",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "documentId",
          "file"
        ],
        "title": "Body_extract_document_internal_documents_extract_post"
      },
      "BoundingBox": {
        "properties": {
          "l": {
            "type": "number",
            "title": "L"
          },
          "t": {
            "type": "number",
            "title": "T"
          },
          "r": {
            "type": "number",
            "title": "R"
          },
          "b": {
            "type": "number",
            "title": "B"
          },
          "coordOrigin": {
            "type": "string",
            "title": "Coordorigin"
          }
        },
        "type": "object",
        "required": [
          "l",
          "t",
          "r",
          "b",
          "coordOrigin"
        ],
        "title": "BoundingBox"
      },
      "ChunkSourceReference": {
        "properties": {
          "blockId": {
            "type": "string",
            "title": "Blockid"
          },
          "pageNumber": {
            "type": "integer",
            "title": "Pagenumber"
          },
          "bbox": {
            "$ref": "#/components/schemas/BoundingBox"
          }
        },
        "type": "object",
        "required": [
          "blockId",
          "pageNumber",
          "bbox"
        ],
        "title": "ChunkSourceReference"
      },
      "ContentBlock": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "type": {
            "type": "string",
            "title": "Type"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "bbox": {
            "$ref": "#/components/schemas/BoundingBox"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "descriptionMethod": {
            "anyOf": [
              {
                "type": "string",
                "const": "vision_model"
              },
              {
                "type": "null"
              }
            ],
            "title": "Descriptionmethod"
          }
        },
        "type": "object",
        "required": [
          "id",
          "type",
          "text",
          "bbox"
        ],
        "title": "ContentBlock"
      },
      "DocumentChunk": {
        "properties": {
          "documentId": {
            "type": "integer",
            "title": "Documentid"
          },
          "source": {
            "type": "string",
            "title": "Source"
          },
          "chunkIndex": {
            "type": "integer",
            "title": "Chunkindex"
          },
          "content": {
            "type": "string",
            "title": "Content"
          },
          "embeddingText": {
            "type": "string",
            "title": "Embeddingtext"
          },
          "headings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Headings"
          },
          "pageStart": {
            "type": "integer",
            "title": "Pagestart"
          },
          "pageEnd": {
            "type": "integer",
            "title": "Pageend"
          },
          "blockIds": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Blockids"
          },
          "sourceRefs": {
            "items": {
              "$ref": "#/components/schemas/ChunkSourceReference"
            },
            "type": "array",
            "title": "Sourcerefs"
          },
          "overlapContent": {
            "type": "string",
            "title": "Overlapcontent",
            "default": ""
          },
          "overlapSourceRefs": {
            "items": {
              "$ref": "#/components/schemas/ChunkSourceReference"
            },
            "type": "array",
            "title": "Overlapsourcerefs"
          },
          "tokenCount": {
            "type": "integer",
            "title": "Tokencount"
          },
          "tokenizerModel": {
            "type": "string",
            "title": "Tokenizermodel"
          }
        },
        "type": "object",
        "required": [
          "documentId",
          "source",
          "chunkIndex",
          "content",
          "embeddingText",
          "headings",
          "pageStart",
          "pageEnd",
          "blockIds",
          "sourceRefs",
          "tokenCount",
          "tokenizerModel"
        ],
        "title": "DocumentChunk"
      },
      "EmbeddingRequest": {
        "properties": {
          "texts": {
            "items": {
              "type": "string",
              "maxLength": 16384,
              "minLength": 1
            },
            "type": "array",
            "maxItems": 32,
            "minItems": 1,
            "title": "Texts"
          },
          "inputType": {
            "type": "string",
            "enum": [
              "passage",
              "query"
            ],
            "title": "Inputtype",
            "default": "passage"
          }
        },
        "type": "object",
        "required": [
          "texts"
        ],
        "title": "EmbeddingRequest"
      },
      "EmbeddingResponse": {
        "properties": {
          "model": {
            "type": "string",
            "title": "Model"
          },
          "dimensions": {
            "type": "integer",
            "title": "Dimensions"
          },
          "vectors": {
            "items": {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            "type": "array",
            "title": "Vectors"
          }
        },
        "type": "object",
        "required": [
          "model",
          "dimensions",
          "vectors"
        ],
        "title": "EmbeddingResponse"
      },
      "ExtractedPage": {
        "properties": {
          "pageNumber": {
            "type": "integer",
            "title": "Pagenumber"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "blocks": {
            "items": {
              "$ref": "#/components/schemas/ContentBlock"
            },
            "type": "array",
            "title": "Blocks"
          }
        },
        "type": "object",
        "required": [
          "pageNumber",
          "text",
          "blocks"
        ],
        "title": "ExtractedPage"
      },
      "ExtractionResponse": {
        "properties": {
          "documentId": {
            "type": "integer",
            "title": "Documentid"
          },
          "source": {
            "type": "string",
            "title": "Source"
          },
          "pageCount": {
            "type": "integer",
            "title": "Pagecount"
          },
          "pages": {
            "items": {
              "$ref": "#/components/schemas/ExtractedPage"
            },
            "type": "array",
            "title": "Pages"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          },
          "chunks": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/DocumentChunk"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Chunks"
          }
        },
        "type": "object",
        "required": [
          "documentId",
          "source",
          "pageCount",
          "pages",
          "warnings"
        ],
        "title": "ExtractionResponse"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "UP",
            "title": "Status"
          },
          "service": {
            "type": "string",
            "const": "studyhub-ai",
            "title": "Service"
          }
        },
        "type": "object",
        "required": [
          "status",
          "service"
        ],
        "title": "HealthResponse"
      }
    },
    "securitySchemes": {
      "APIKeyHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-AI-Service-Token"
      }
    }
  }
}
